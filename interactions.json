[
  {
    "id": "int-scroll-reveal",
    "name": "进入视口揭示",
    "family": "滚动",
    "aliases": [
      "Scroll reveal",
      "Reveal on scroll",
      "滚动出现"
    ],
    "definition": "元素进入视口时做一次位移或淡入，用时间差把阅读顺序讲清楚。",
    "cues": [
      "滚入时淡入或上移",
      "一次性触发、回滚不回放",
      "同屏元素依次错开"
    ],
    "boundary": "随滚动持续变速的位移不算揭示，归 int-scroll-parallax；只在首次加载播放的归 int-preloader。",
    "source": [
      {
        "label": "Awwwards Elements",
        "url": "https://www.awwwards.com/elements/",
        "retrieved": "2026-10-27"
      },
      {
        "label": "Httpster",
        "url": "https://httpster.net/",
        "retrieved": "2026-10-27"
      }
    ],
    "related": [
      "motion-feedback",
      "layout-hierarchy"
    ],
    "status": "active"
  },
  {
